generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  username     String?   @unique
  passwordHash String
  role         Role
  status       String    @default("active")
  isFirstLogin Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student             Student?
  teacher             Teacher?
  admin               Admin?
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  fullName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  studentNumber String    @unique
  studentCode   String    @unique
  fullName      String
  gender        String?
  birthDate     DateTime?
  email         String    @unique
  contactNumber String?
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile            StudentProfile?
  heightWeightRecords HeightWeightRecord[]
  sectionAssignments  StudentSectionAssignment[]
  attendanceRecords   AttendanceRecord[]
  scores              StudentScore[]
}

model StudentProfile {
  id               String   @id @default(uuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id])
  profilePicture   String?
  address          String?
  guardianName     String?
  guardianContact  String?
  emergencyContact String?
  biography        String?
  updatedAt        DateTime @updatedAt
}

model HeightWeightRecord {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id])
  height            Float
  weight            Float
  bmi               Float?
  bmiClassification String?
  recordedAt        DateTime @default(now())
}

model Teacher {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  employeeId    String?
  fullName      String
  email         String   @unique
  department    String?
  contactNumber String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  profile               TeacherProfile?
  subjectAssignments    TeacherSubjectAssignment[]
  attendanceSessions    AttendanceSession[]
  academicActivities    AcademicActivity[]
  presentationMaterials PresentationMaterial[]
  classSchedules        ClassSchedule[]
}

model TeacherProfile {
  id             String   @id @default(uuid())
  teacherId      String   @unique
  teacher        Teacher  @relation(fields: [teacherId], references: [id])
  profilePicture String?
  updatedAt      DateTime @updatedAt
}

model AcademicYear {
  id        String    @id @default(uuid())
  name      String    @unique
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  status    String    @default("active")
  createdAt DateTime  @default(now())

  semesters             Semester[]
  sectionAssignments    StudentSectionAssignment[]
  teacherAssignments    TeacherSubjectAssignment[]
  classSchedules        ClassSchedule[]
  academicActivities    AcademicActivity[]
  presentationMaterials PresentationMaterial[]
}

model Semester {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  name           String
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
}

model GradeLevel {
  id       String     @id @default(uuid())
  name     String     @unique
  order    Int
  strands  Strand[]
  sections Section[]
}

model Strand {
  id           String     @id @default(uuid())
  gradeLevelId String
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id])
  name         String
  sections     Section[]
}

model Section {
  id           String     @id @default(uuid())
  gradeLevelId String
  gradeLevel   GradeLevel @relation(fields: [gradeLevelId], references: [id])
  strandId     String?
  strand       Strand?    @relation(fields: [strandId], references: [id])
  name         String
  status       String     @default("active")
  createdAt    DateTime   @default(now())

  sectionAssignments StudentSectionAssignment[]
  teacherAssignments TeacherSubjectAssignment[]
  classSchedules     ClassSchedule[]
  attendanceSessions AttendanceSession[]
  academicActivities AcademicActivity[]
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  teacherAssignments    TeacherSubjectAssignment[]
  classSchedules        ClassSchedule[]
  attendanceSessions    AttendanceSession[]
  academicActivities    AcademicActivity[]
  presentationMaterials PresentationMaterial[]
}

model StudentSectionAssignment {
  id             String       @id @default(uuid())
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  gradeLevelId   String
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([studentId, academicYearId])
}

model TeacherSubjectAssignment {
  id             String       @id @default(uuid())
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  createdAt      DateTime     @default(now())

  classSchedules        ClassSchedule[]
  presentationMaterials PresentationMaterial[]
}

model ClassSchedule {
  id             String                    @id @default(uuid())
  subjectId      String
  subject        Subject                   @relation(fields: [subjectId], references: [id])
  teacherId      String
  teacher        Teacher                   @relation(fields: [teacherId], references: [id])
  sectionId      String
  section        Section                   @relation(fields: [sectionId], references: [id])
  academicYearId String
  academicYear   AcademicYear              @relation(fields: [academicYearId], references: [id])
  assignmentId   String?
  assignment     TeacherSubjectAssignment? @relation(fields: [assignmentId], references: [id])
  scheduleImage  String?
  description    String?
  dayOfWeek      String?
  startTime      String?
  endTime        String?
  uploadedAt     DateTime                  @default(now())
}

model AttendanceSession {
  id              String             @id @default(uuid())
  subjectId       String
  subject         Subject            @relation(fields: [subjectId], references: [id])
  sectionId       String
  section         Section            @relation(fields: [sectionId], references: [id])
  teacherId       String
  teacher         Teacher            @relation(fields: [teacherId], references: [id])
  attendanceDate  DateTime
  sessionCode     String?            @unique
  sessionStatus   String             @default("open")
  sessionExpiry   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  attendanceRecords AttendanceRecord[]
}

model AttendanceRecord {
  id                 String            @id @default(uuid())
  studentId          String
  student            Student           @relation(fields: [studentId], references: [id])
  sessionId          String
  session            AttendanceSession @relation(fields: [sessionId], references: [id])
  status             String            @default("present")
  timeRecorded       DateTime          @default(now())
  verificationStatus String            @default("verified")

  @@unique([studentId, sessionId])
}

model AcademicActivity {
  id             String       @id @default(uuid())
  title          String
  subjectId      String
  subject        Subject      @relation(fields: [subjectId], references: [id])
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id])
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  category       String
  totalScore     Float
  activityDate   DateTime     @default(now())
  createdAt      DateTime     @default(now())

  studentScores StudentScore[]
}

model StudentScore {
  id            String           @id @default(uuid())
  studentId     String
  student       Student          @relation(fields: [studentId], references: [id])
  activityId    String
  activity      AcademicActivity @relation(fields: [activityId], references: [id])
  scoreObtained Float
  totalScore    Float
  evidenceFile  String?
  dateRecorded  DateTime         @default(now())

  @@unique([studentId, activityId])
}

model PresentationMaterial {
  id             String                    @id @default(uuid())
  subjectId      String
  subject        Subject                   @relation(fields: [subjectId], references: [id])
  teacherId      String
  teacher        Teacher                   @relation(fields: [teacherId], references: [id])
  sectionId      String?
  academicYearId String
  academicYear   AcademicYear              @relation(fields: [academicYearId], references: [id])
  assignmentId   String?
  assignment     TeacherSubjectAssignment? @relation(fields: [assignmentId], references: [id])
  fileName       String
  fileType       String
  filePath       String
  uploadDate     DateTime                  @default(now())
}

model AnnouncementCategory {
  id         String   @id @default(uuid())
  name       String   @unique
  icon       String?
  coverImage String?
  order      Int      @default(0)
  status     String   @default("active")
  createdAt  DateTime @default(now())

  announcements Announcement[]
}

model Announcement {
  id              String               @id @default(uuid())
  title           String
  categoryId      String
  category        AnnouncementCategory @relation(fields: [categoryId], references: [id])
  description     String?
  image           String?
  content         String?
  publishStatus   String               @default("published")
  displayPriority Int                  @default(0)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
